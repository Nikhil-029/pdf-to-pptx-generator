# ── LLM ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO / S3 ───────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_UPLOADS=pdf-uploads
MINIO_BUCKET_OUTPUTS=pptx-outputs

# ── Images ───────────────────────────────────────────────────────────────────
# Optional: used to pull stock images for slide backgrounds. Get a free key
# at https://unsplash.com/developers. The app degrades gracefully without one.
UNSPLASH_ACCESS_KEY=

# ── CORS (comma-separated list for production) ───────────────────────────────
# CORS_ORIGINS=["https://yourdomain.com","https://app.yourdomain.com"]
